{% extends 'base.html.twig' %}

{% block title %}{{ post.title }} | Admin blog{% endblock %}

{% block body %}
<div class="container">
    <article class="content-panel blog-post-card">
        <a href="{{ path('app_admin_blog_index') }}" class="btn-secondary btn-small">&larr; Retour au blog</a>

        <h1>{{ post.title }}</h1>
        <p class="blog-meta">Publie le {{ post.publish_date|date('d/m/Y') }}</p>

        <div class="tag-row">
            {% for category in post.categories %}
                <span class="blog-tag">{{ category }}</span>
            {% endfor %}
        </div>

        {% for block in post.contents %}
            <div class="blog-text-block">{{ block|nl2br }}</div>
        {% endfor %}

        {% include 'blog/_media_and_links.html.twig' with {post: post} only %}

        <div class="button-row" style="margin-top: 1.5rem;">
            <a class="btn-primary" href="{{ path('app_admin_blog_edit', {id: post.id}) }}">Modifier</a>
            <form method="post" action="{{ path('app_admin_blog_delete', {id: post.id}) }}" onsubmit="return confirm('Confirmer la suppression ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_blog_delete_' ~ post.id) }}">
                <button type="submit" class="btn-danger">Supprimer</button>
            </form>
        </div>
    </article>
</div>
{% endblock %}
