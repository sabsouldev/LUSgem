{% extends 'base.html.twig' %}

{% block title %}Fiche adherent {{ user.email }} | Les Univers Singuliers{% endblock %}

{% block body %}
<div class="container">
    <section class="content-panel">
        <a href="{{ path('app_admin_adherents') }}" class="btn-secondary btn-small">&larr; Retour a la liste</a>
        <h1>Fiche de {{ profile.first_name|default('') }} {{ profile.last_name|default(user.email) }}</h1>
        <p class="blog-meta">ID: {{ user.id }} — {{ user.email }}</p>

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <p class="flash flash-{{ type }}">{{ message }}</p>
            {% endfor %}
        {% endfor %}
    </section>

    <section class="content-panel">
        <h2>Informations adherent</h2>
        <form method="post" class="contact-form">
            <input type="hidden" name="adherent_action" value="save_profile">
            <input type="hidden" name="user_id" value="{{ user.id }}">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_member_profile_' ~ user.id) }}">

            <div class="grid-two">
                <div>
                    <label for="first_name">Prenom</label>
                    <input id="first_name" name="first_name" type="text" value="{{ profile.first_name|default('') }}">
                </div>
                <div>
                    <label for="last_name">Nom</label>
                    <input id="last_name" name="last_name" type="text" value="{{ profile.last_name|default('') }}">
                </div>
                <div>
                    <label for="phone">Telephone</label>
                    <input id="phone" name="phone" type="text" value="{{ profile.phone|default('') }}">
                </div>
                <div>
                    <label for="city">Ville</label>
                    <input id="city" name="city" type="text" value="{{ profile.city|default('') }}">
                </div>
                <div>
                    <label for="postal_code">Code postal</label>
                    <input id="postal_code" name="postal_code" type="text" value="{{ profile.postal_code|default('') }}">
                </div>
                <div>
                    <label for="role_level">Type de compte</label>
                    <select id="role_level" name="role_level">
                        <option value="member" {% if 'ROLE_ADMIN' not in user.roles %}selected{% endif %}>Adherent</option>
                        <option value="admin" {% if 'ROLE_ADMIN' in user.roles %}selected{% endif %}>Administrateur</option>
                    </select>
                </div>
            </div>

            <label for="address">Adresse</label>
            <textarea id="address" name="address" rows="2">{{ profile.address|default('') }}</textarea>

            <div class="grid-two">
                <div>
                    <label for="cotisation_status">Cotisation</label>
                    <input id="cotisation_status" name="cotisation_status" type="text" value="{{ profile.cotisation_status|default('') }}" placeholder="Ex: A jour, En attente">
                </div>
                <div>
                    <label for="cotisation_date">Date cotisation</label>
                    <input id="cotisation_date" name="cotisation_date" type="date" value="{{ profile.cotisation_date|default('') }}">
                </div>
                <div>
                    <label for="attestation_status">Attestation</label>
                    <input id="attestation_status" name="attestation_status" type="text" value="{{ profile.attestation_status|default('') }}" placeholder="Ex: Recue, A relancer">
                </div>
                <div>
                    <label for="attestation_date">Date attestation</label>
                    <input id="attestation_date" name="attestation_date" type="date" value="{{ profile.attestation_date|default('') }}">
                </div>
            </div>

            <label for="extra_fields">Champs personnalises (libre)</label>
            <textarea id="extra_fields" name="extra_fields" rows="2" placeholder="Ex: regime, contact urgence, suivi particulier">{{ profile.extra_fields|default('') }}</textarea>

            <label for="notes">Notes admin</label>
            <textarea id="notes" name="notes" rows="3">{{ profile.notes|default('') }}</textarea>

            <div class="button-row">
                <button type="submit" class="btn-primary">Enregistrer la fiche</button>
            </div>
        </form>
    </section>

    <section class="content-panel">
        <h2>Reinitialiser le mot de passe</h2>
        <form method="post" class="contact-form">
            <input type="hidden" name="adherent_action" value="reset_password">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_member_reset_password') }}">
            <input type="hidden" name="user_id" value="{{ user.id }}">

            <label for="new_password">Nouveau mot de passe (min 8 caracteres)</label>
            <div class="button-row">
                <input id="new_password" name="new_password" type="text" minlength="8" placeholder="Nouveau mot de passe" required>
                <button type="submit" class="btn-secondary">Mettre a jour</button>
            </div>
        </form>
    </section>
</div>
{% endblock %}