{% extends 'base.html.twig' %}

{% block title %}Messages de contact | Les Univers Singuliers{% endblock %}

{% block body %}
<div class="container">
    <section class="content-panel">
        <h1>Messages de contact</h1>
        <p>Historique des messages recus depuis le formulaire public.</p>

        {% for type, flashes in app.flashes %}
            {% for flash in flashes %}
                <p class="flash flash-{{ type }}">{{ flash }}</p>
            {% endfor %}
        {% endfor %}

        {% if messages is empty %}
            <p>Aucun message recu pour le moment.</p>
        {% else %}
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Objet</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for msg in messages %}
                        <tr>
                            <td>{{ msg.createdAt|date('d/m/Y H:i') }}</td>
                            <td>{{ msg.name }}</td>
                            <td><a href="mailto:{{ msg.email }}">{{ msg.email }}</a></td>
                            <td>{{ msg.subject }}</td>
                            <td>
                                {% if msg.read %}
                                    <span class="badge badge-success">Lu</span>
                                {% else %}
                                    <span class="badge badge-pending">Non lu</span>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('app_admin_message_show', {id: msg.id}) }}" class="btn-primary btn-small">Voir</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>
</div>
{% endblock %}
