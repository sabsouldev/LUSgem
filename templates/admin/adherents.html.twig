{% extends 'base.html.twig' %}

{% block title %}Gestion des adherents | Les Univers Singuliers{% endblock %}

{% block body %}
<div class="container">
    <section class="content-panel">
        <h1>Gestion des adherents</h1>
        <p>Creation des comptes, suivi des coordonnees et champs administratifs, propositions internes, export des donnees.</p>

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <p class="flash flash-{{ type }}">{{ message }}</p>
            {% endfor %}
        {% endfor %}
    </section>

    <section class="grid-two">
        <article class="content-panel">
            <h2>Creer un compte</h2>
            <form method="post" class="contact-form">
                <input type="hidden" name="adherent_action" value="create_account">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_member_create') }}">

                <label for="create_email">Email</label>
                <input id="create_email" name="email" type="email" required>

                <label for="create_password">Mot de passe provisoire (min 8 caracteres)</label>
                <input id="create_password" name="password" type="text" minlength="8" required>

                <label for="create_role_level">Type de compte</label>
                <select id="create_role_level" name="role_level">
                    <option value="member">Adherent</option>
                    <option value="admin">Administrateur</option>
                </select>

                <button type="submit" class="btn-primary">Creer le compte</button>
            </form>
        </article>

        <article class="content-panel">
            <h2>Exporter le tableau adherents</h2>
            <p>Telecharge un CSV avec coordonnees, cotisation, attestation et champs personnalises.</p>
            <a class="btn-primary" href="{{ path('app_admin_adherents_export') }}">Telecharger le CSV</a>
        </article>
    </section>

    <section class="content-panel">
        <h2>Fiches adherents</h2>
        {% if users is empty %}
            <p>Aucun adherent en base de donnees.</p>
        {% else %}
            <div style="overflow-x: auto;">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Email</th>
                            <th>Prenom</th>
                            <th>Nom</th>
                            <th>Telephone</th>
                            <th>Ville</th>
                            <th>Cotisation</th>
                            <th>Role</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            {% set profile = profiles[user.id|default(0)] ?? {} %}
                            <tr>
                                <td>{{ user.id }}</td>
                                <td>{{ user.email }}</td>
                                <td>{{ profile.first_name|default('-') }}</td>
                                <td>{{ profile.last_name|default('-') }}</td>
                                <td>{{ profile.phone|default('-') }}</td>
                                <td>{{ profile.city|default('-') }}</td>
                                <td>{{ profile.cotisation_status|default('-') }}</td>
                                <td>{% if 'ROLE_ADMIN' in user.roles %}Admin{% else %}Adherent{% endif %}</td>
                                <td>
                                    <a href="{{ path('app_admin_adherent_edit', {id: user.id}) }}" class="btn-primary btn-small">Modifier</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    <section class="content-panel">
        <a href="{{ path('app_admin_propositions') }}" class="btn-secondary">Voir toutes les propositions</a>
    </section>
</div>
{% endblock %}
