{% extends 'base.html.twig' %}

{% block title %}Gestion des adhérents | Les Univers Singuliers{% endblock %}

{% block body %}
<div class="container">
    <section class="content-panel">
        <h1>Gestion des adhérents</h1>
        <p>Les comptes sont créés uniquement par l'administrateur. Aucune inscription publique n'est proposée.</p>

        <ul>
            <li>Créer un compte adhérent.</li>
            <li>Attribuer les rôles (ROLE_MEMBER / ROLE_ADMIN).</li>
            <li>Réinitialiser un mot de passe.</li>
            <li>Désactiver un compte.</li>
        </ul>
    </section>
</div>
{% endblock %}
