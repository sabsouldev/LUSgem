{% extends 'base.html.twig' %}

{% block title %}Gestion des publications | Les Univers Singuliers{% endblock %}

{% block body %}
<div class="container">
    <section class="content-panel">
        <h1>Gestion des publications</h1>
        <p>Tous les formulaires d'administration sont centralises ici.</p>

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <p class="flash flash-{{ type }}">{{ message }}</p>
            {% endfor %}
        {% endfor %}
    </section>

    <section class="grid-two">
        <article class="content-panel">
            <h2>Planning hebdomadaire (PDF)</h2>
            <form method="post" enctype="multipart/form-data" class="contact-form">
                <input type="hidden" name="publication_action" value="planning_upload">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_planning') }}">

                <label for="planning_pdf">Fichier PDF</label>
                <input id="planning_pdf" name="planning_pdf" type="file" accept=".pdf" required>

                <button type="submit" class="btn-primary">Mettre a jour le planning</button>
            </form>

            {% if planning_file %}
                <p><a href="{{ planning_file }}" target="_blank" rel="noopener">Voir le planning actuel</a></p>
            {% endif %}
        </article>

        <article class="content-panel">
            <h2>Compte rendu (PDF)</h2>
            <form method="post" enctype="multipart/form-data" class="contact-form">
                <input type="hidden" name="publication_action" value="report_upload">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_report') }}">

                <label for="report_month">Mois (YYYY-MM)</label>
                <input id="report_month" name="report_month" type="month" required>

                <label for="report_pdf">Fichier PDF</label>
                <input id="report_pdf" name="report_pdf" type="file" accept=".pdf" required>

                <button type="submit" class="btn-primary">Publier le compte rendu</button>
            </form>

            {% if reports is not empty %}
                <p>Derniers comptes rendus:</p>
                <ul>
                    {% for item in reports|slice(0, 5) %}
                        <li><a href="/uploads/comptes-rendus/{{ item }}" target="_blank" rel="noopener">{{ item }}</a></li>
                    {% endfor %}
                </ul>
            {% endif %}
        </article>

        <article class="content-panel">
            <h2>Mooks (PDF)</h2>
            <form method="post" enctype="multipart/form-data" class="contact-form">
                <input type="hidden" name="publication_action" value="mook_upload">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_mook') }}">

                <label for="mook_number">Numero du mook</label>
                <select id="mook_number" name="mook_number" required>
                    <option value="1">MOOK 1</option>
                    <option value="2">MOOK 2</option>
                </select>

                <label for="mook_pdf">Fichier PDF</label>
                <input id="mook_pdf" name="mook_pdf" type="file" accept=".pdf" required>

                <button type="submit" class="btn-primary">Mettre a jour le mook</button>
            </form>

            {% if mooks is not empty %}
                <p>Mooks disponibles:</p>
                <ul>
                    {% for item in mooks %}
                        <li><a href="/uploads/mooks/{{ item }}" target="_blank" rel="noopener">{{ item }}</a></li>
                    {% endfor %}
                </ul>
            {% endif %}
        </article>

        <article class="content-panel">
            <h2>Newsletter mensuelle</h2>
            <form method="post" class="contact-form">
                <input type="hidden" name="publication_action" value="newsletter_publish">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_newsletter') }}">

                <label for="newsletter_month">Mois (YYYY-MM)</label>
                <input id="newsletter_month" name="newsletter_month" type="month" required>

                <label for="newsletter_title">Titre</label>
                <input id="newsletter_title" name="newsletter_title" type="text" required>

                <label for="newsletter_content">Contenu</label>
                <textarea id="newsletter_content" name="newsletter_content" rows="6" required></textarea>

                <button type="submit" class="btn-primary">Publier la newsletter</button>
            </form>

            {% if newsletters is not empty %}
                <p>Dernieres newsletters:</p>
                <ul>
                    {% for item in newsletters|slice(0, 3) %}
                        <li>{{ item.month }} - {{ item.title }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </article>

    </section>
</div>
{% endblock %}
