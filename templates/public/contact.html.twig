{% extends 'base.html.twig' %}

{% block title %}Contact | Les Univers Singuliers{% endblock %}

{% block body %}
<div class="container">
    <section class="content-panel">
        <h1>Contact</h1>
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <p class="flash flash-{{ type }}">{{ message }}</p>
            {% endfor %}
        {% endfor %}
        <p>Pour toute demande institutionnelle, partenariat ou renseignement, utilisez les coordonnées ci-dessous ou le formulaire sécurisé.</p>
    </section>

    <section class="grid-two">
         <article class="content-panel">
            <h2>Coordonnées</h2>
            <ul class="contact-list">
                <li><strong>Adresse :</strong> 35 rue Talleyrand Périgord, 24000 Périgueux</li>
                <li><strong>Téléphone :</strong> (à compléter)</li>
                <li><strong>Email :</strong> (à compléter)</li>
                <li><strong>Horaires d'accueil :</strong> (à compléter)</li>
            </ul>

            <div style="margin-top: 1rem; border-radius: 12px; overflow: hidden; border: 2px solid #D6E5FF;">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2836.5!2d0.7167!3d45.1847!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2s35+rue+Talleyrand+P%C3%A9rigord+24000+P%C3%A9rigueux!5e0!3m2!1sfr!2sfr!4v1"
                    width="100%"
                    height="300"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="Localisation du GEM Les Univers Singuliers">
                </iframe>
            </div>
        </article>

        <article class="content-panel">
            <h2>Formulaire de contact sécurisé</h2>
            <form method="post" action="{{ path('app_contact') }}" class="contact-form">
                <input type="hidden" name="_token" value="{{ csrf_token('contact_form') }}">
                <label for="name">Nom</label>
                <input id="name" name="name" type="text" required>

                <label for="email">Email</label>
                <input id="email" name="email" type="email" required>

                <label for="subject">Objet</label>
                <input id="subject" name="subject" type="text" required>

                <label for="message">Message</label>
                <textarea id="message" name="message" rows="6" required></textarea>

                <button type="submit" class="btn-primary">Envoyer</button>
            </form>
        </article>
    </section>
</div>
{% endblock %}
