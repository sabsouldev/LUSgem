{% extends 'base.html.twig' %}

{% block title %}Blog et Newsletter | Les Univers Singuliers{% endblock %}

{% block body %}
<div class="container">
    <section class="content-panel">
        <h1>Blog et Newsletter</h1>
        <p>Cette rubrique centralise les articles institutionnels, les informations importantes et la newsletter mensuelle.</p>
    </section>

    <section class="content-panel">
        <h2>Articles du blog adherents</h2>
        <p>Les articles du blog interne sont accessibles uniquement depuis l'espace adherent securise.</p>
        <p><a class="btn-primary" href="{{ path('app_login') }}">Connexion adherent</a></p>
    </section>

    <section class="content-panel">
        <h2>Newsletter mensuelle</h2>

        {% if newsletters is not empty %}
            <ul>
                {% for item in newsletters %}
                    <li><strong>{{ item.month }}</strong> - {{ item.title }}</li>
                {% endfor %}
            </ul>
        {% else %}
            <p>Aucune newsletter publiee pour le moment.</p>
        {% endif %}
    </section>

    <section class="grid-two">
        <article class="content-panel">
            <h2>Informations importantes</h2>
            <p>Les annonces urgentes ou prioritaires apparaissent en premier avec une date et un statut clair.</p>
        </article>

        <article class="content-panel">
            <h2>Prochain numero</h2>
            <p>Themes en preparation: bilan mensuel, activites a venir, ressources et retours d'experience.</p>
        </article>
    </section>
</div>
{% endblock %}
