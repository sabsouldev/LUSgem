{% if post.media is defined and post.media|length > 0 %}
    {% for media in post.media %}
        {% if media.type == 'image' %}
            <figure class="blog-figure">
                <img src="{{ media.path }}" alt="{{ media.name }}" loading="lazy">
                {% if media.name != '' %}
                    <figcaption>{{ media.name }}</figcaption>
                {% endif %}
            </figure>

        {% elseif media.type == 'video' %}
            <div class="blog-media-block">
                <video controls preload="metadata">
                    <source src="{{ media.path }}" type="{{ media.mime_type|default('video/mp4') }}">
                    Votre navigateur ne prend pas en charge la video.
                </video>
            </div>

        {% elseif media.type == 'audio' %}
            <div class="blog-media-block">
                <p class="blog-meta">{{ media.name }}</p>
                <audio controls preload="none">
                    <source src="{{ media.path }}" type="{{ media.mime_type|default('audio/mpeg') }}">
                    Votre navigateur ne prend pas en charge l'audio.
                </audio>
            </div>

        {% elseif media.type == 'pdf' %}
            <div class="blog-media-block">
                <a class="btn-secondary" href="{{ media.path }}" target="_blank" rel="noopener">{{ media.name }} (PDF)</a>
                <a class="btn-primary btn-small" href="{{ media.path }}" download>Telecharger</a>
            </div>
        {% endif %}
    {% endfor %}
{% endif %}

{% if post.external_links is defined and post.external_links is not empty %}
    <section style="margin-top: 1.5rem;">
        <h2>Videos et podcasts</h2>
        {% for link in post.external_links %}
            <div class="blog-media-block">
               {% if link.embed_type == 'youtube' %}
                    <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px;">
                        <iframe
                            src="{{ link.embed_url }}"
                            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
                            allowfullscreen
                            loading="lazy"
                            title="{{ link.title }}">
                        </iframe>
                    </div>
                    <p class="blog-meta" style="margin-top: 0.5rem;">{{ link.title }}</p>

                {% elseif link.embed_type == 'spotify' %}
                    <iframe
                        src="{{ link.embed_url }}"
                        width="100%" height="232" frameborder="0"
                        allow="encrypted-media" loading="lazy"
                        style="border-radius: 12px;">
                    </iframe>
                    <p class="blog-meta">{{ link.title }}</p>

                {% else %}
                    <a href="{{ link.url }}" target="_blank" rel="noopener" class="btn-secondary">
                        {{ link.title }}
                    </a>
                {% endif %}
            </div>
        {% endfor %}
    </section>
{% endif %}
