{% extends 'base.html.twig' %}

{% block title %}Comptes rendus | Les Univers Singuliers{% endblock %}

{% block body %}
<div class="container">
    <section class="content-panel">
        <h1>Comptes rendus</h1>
        <p>Historique des documents internes publiés au format PDF.</p>

        {% if reports is empty %}
            <p>Aucun compte rendu n'a encore été publié.</p>
        {% else %}
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Document</th>
                        <th>Date de publication</th>
                        <th>Accès</th>
                    </tr>
                </thead>
                <tbody>
                    {% for doc in reports %}
                        <tr>
                            <td>{{ doc.label }}</td>
                            <td>{{ doc.uploadedAt|date('d/m/Y') }}</td>
                            <td><a href="{{ doc.publicPath }}" target="_blank" rel="noopener">Télécharger (PDF)</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>
</div>
{% endblock %}
