{% extends 'base.html.twig' %}

{% block title %}Newsletter adhérents | Les Univers Singuliers{% endblock %}

{% block body %}
<div class="container">
    <section class="content-panel">
        <h1>Newsletter adhérents</h1>
        <p>Publication mensuelle interne à destination des adhérents.</p>

        {% if newsletters is empty %}
            <p>Aucune newsletter n'a encore été publiée.</p>
        {% else %}
            {% for item in newsletters %}
                <article class="content-panel" style="margin-bottom: 1.5rem;">
                    <h2>{{ item.title }}</h2>
                    <p class="blog-meta">{{ item.month }}</p>
                    <div>{{ item.content|nl2br }}</div>
                </article>
            {% endfor %}
        {% endif %}
    </section>
</div>
{% endblock %}
