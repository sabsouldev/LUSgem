<header class="site-header">
    <div class="container header-inner">
        <div class="brand-block">
            <img src="{{ asset('images/logo_LUS.png') }}" alt="Logo Les Univers Singuliers" class="brand-logo">
            <div>
                <p class="brand-title">Les Univers Singuliers</p>
                <p class="brand-subtitle">GEM - Association pour adultes autistes - Périgueux</p>
            </div>
        </div>

        <button class="burger-btn" aria-label="Ouvrir le menu" aria-expanded="false" onclick="this.closest('.header-inner').classList.toggle('nav-open'); this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'false' ? 'true' : 'false');">
            <span class="burger-line"></span>
            <span class="burger-line"></span>
            <span class="burger-line"></span>
        </button>

        <div class="nav-group">
            <nav aria-label="Navigation principale" class="main-nav">
                <a href="{{ path('app_home') }}">Accueil</a>
                <a href="{{ path('app_mooks') }}">Mooks</a>
                <a href="{{ path('app_contact') }}">Contact</a>
            </nav>

            <nav aria-label="Accès adhérents" class="member-nav">
                {% if app.user %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}">Administration</a>
                    {% elseif is_granted('ROLE_MEMBER') %}
                        <a href="{{ path('app_member_dashboard') }}">Espace adhérent</a>
                    {% endif %}
                    <a href="{{ path('app_logout') }}">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Connexion adhérent</a>
                    <a href="{{ path('app_admin_dashboard') }}">Administration</a>
                {% endif %}
            </nav>
        </div>
    </div>
</header>
