<header class="site-header">
    <div class="container header-inner">
        <div class="brand-block">
            <img src="{{ asset('images/logo_LUS.png') }}" alt="Logo Les Univers Singuliers" class="brand-logo">
            <div>
                <p class="brand-title">Les Univers Singuliers</p>
                <p class="brand-subtitle">GEM - Association pour adultes autistes - Périgueux</p>
            </div>
        </div>

        <nav aria-label="Navigation principale" class="main-nav">
            <a href="{{ path('app_home') }}">Accueil</a>
            <a href="{{ path('app_fonctionnement') }}">Fonctionnement</a>
            <a href="{{ path('app_charte') }}">Charte</a>
            <a href="{{ path('app_activites') }}">Activites</a>
            <a href="{{ path('app_mooks') }}">Mooks</a>
            <a href="{{ path('app_blog') }}">Blog & Newsletter</a>
            <a href="{{ path('app_contact') }}">Contact</a>
        </nav>

        <nav aria-label="Acces adherents" class="member-nav">
            {% if app.user %}
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_admin_dashboard') }}">Administration</a>
                {% elseif is_granted('ROLE_MEMBER') %}
                    <a href="{{ path('app_member_dashboard') }}">Espace adherent</a>
                {% endif %}
                <a href="{{ path('app_logout') }}">Deconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}">Connexion adherent</a>
                <a href="{{ path('app_admin_dashboard') }}">Administration</a>
            {% endif %}
        </nav>
    </div>
</header>
