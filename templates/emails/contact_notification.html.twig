<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
</head>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #1a1a2e; max-width: 600px; margin: 0 auto; padding: 20px;">
    <h2 style="color: #1350A2; border-bottom: 2px solid #FFDF57; padding-bottom: 10px;">
        Nouveau message de contact
    </h2>

    <table style="width: 100%; border-collapse: collapse; margin-top: 15px;">
        <tr>
            <td style="padding: 8px; font-weight: bold; color: #555; width: 100px;">Nom</td>
            <td style="padding: 8px;">{{ contactMessage.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; font-weight: bold; color: #555;">Email</td>
            <td style="padding: 8px;"><a href="mailto:{{ contactMessage.email }}">{{ contactMessage.email }}</a></td>
        </tr>
        <tr>
            <td style="padding: 8px; font-weight: bold; color: #555;">Objet</td>
            <td style="padding: 8px;">{{ contactMessage.subject }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; font-weight: bold; color: #555;">Date</td>
            <td style="padding: 8px;">{{ contactMessage.createdAt|date('d/m/Y H:i') }}</td>
        </tr>
    </table>

    <div style="background: #e9f1fb; border-radius: 8px; padding: 15px; margin-top: 15px;">
        <p style="font-weight: bold; color: #1350A2; margin: 0 0 8px;">Message :</p>
        <p style="margin: 0; white-space: pre-wrap;">{{ contactMessage.message }}</p>
    </div>

    <p style="margin-top: 20px; font-size: 0.85rem; color: #555;">
        Ce message a été envoyé via le formulaire de contact du site Les Univers Singuliers.
    </p>
</body>
</html>
