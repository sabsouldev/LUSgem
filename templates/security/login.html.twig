{% extends 'base.html.twig' %}

{% block title %}Connexion adhérent | Les Univers Singuliers{% endblock %}

{% block body %}
<div class="container">
    <section class="content-panel auth-panel">
        <h1>Connexion adhérent</h1>
        <p>Les comptes sont créés uniquement par l'administrateur. Aucune inscription en ligne n'est disponible.</p>

        {% if error %}
            <p class="form-error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
        {% endif %}

        <form method="post" class="contact-form">
            <label for="username">Email</label>
            <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus>

            <label for="password">Mot de passe</label>
            <input type="password" name="_password" id="password" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button class="btn-primary" type="submit">Se connecter</button>
        </form>
    </section>
</div>
{% endblock %}
